# Copy this file to .env and fill in real values. .env is gitignored.

# Identifies this app to the SEC (required): "AppName/version contact@email.com"
SEC_USER_AGENT="FullDisclosure/0.1 you@example.com"

# Anthropic API key for the filing analysis: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Postgres connection string (Supabase dashboard > Connect > Session pooler)
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres"

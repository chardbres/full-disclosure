# Copy to .env.local for local development. On Vercel, set these in the
# project's Environment Variables.

# Read-only Postgres login for the website (see README). Use Supabase's
# transaction pooler, port 6543, which suits serverless functions.
DATABASE_URL="postgresql://fd_reader.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Identifies this app to the SEC when looking up company names
SEC_USER_AGENT="FullDisclosure/0.1 you@example.com"

# Sign-in for the site's admin (optional). Without all three, the site runs
# read-only and no one can sign in. The URL and publishable key are in
# Supabase under Project Settings > API Keys; both are safe to expose.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# The only email allowed to sign in as admin
ADMIN_EMAIL="you@example.com"

# For the admin's Analyze button (optional). A fine-grained GitHub token with
# access to only this repo and the "Actions: Read and write" permission.
GITHUB_DISPATCH_TOKEN="github_pat_..."
# A long random string, also saved as a GitHub Actions secret, that lets the
# daily job tell the site to show new analyses right away
REVALIDATE_SECRET="..."

# Copy to .env.local for local development. On Vercel, set these in the
# project's Environment Variables.

# Read-only Postgres login for the website (see README). Use Supabase's
# transaction pooler, port 6543, which suits serverless functions.
DATABASE_URL="postgresql://fd_reader.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Identifies this app to the SEC when looking up company names
SEC_USER_AGENT="FullDisclosure/0.1 you@example.com"
